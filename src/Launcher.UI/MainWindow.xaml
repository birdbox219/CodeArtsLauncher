<Window x:Class="Launcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.Core.ViewModels;assembly=Launcher.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Birdbox Launcher"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <!-- WindowChrome keeps snap, maximize and resize working with a custom title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5"
                            Background="{StaticResource PrimaryAccentGradient}" />
                    <TextBlock Text="BIRDBOX LAUNCHER" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ProfileName, StringFormat=itch.io/{0}}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextFaintBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Update all" Style="{StaticResource GhostButton}" Height="28"
                            Padding="12,0" Margin="0,0,8,0"
                            Command="{Binding UpdateAllCommand}"
                            Visibility="{Binding HasPendingUpdates, Converter={StaticResource BoolToVisible}}" />
                    <Button Style="{StaticResource IconButton}" Padding="10,4" FontSize="12"
                            Content="Minimize" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource CloseWindowButton}" Padding="10,4" FontSize="12"
                            Content="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="332" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- === Library rail === -->
            <Border Grid.Column="0" Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LIBRARY" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding LibrarySummary}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="28"
                                Padding="10,0" Content="Sync"
                                Command="{Binding SyncLibraryCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <!-- Search -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search games" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>

                    <!-- Game list -->
                    <ListBox Grid.Row="2" x:Name="GameList"
                             ItemsSource="{Binding VisibleGames}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource GameListItem}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover, with an initial behind it so a missing image still reads -->
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="7"
                                            Background="#1B202D" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold"
                                                       Foreground="#3F4757"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding CoverImageUrl,
                                                            Converter={StaticResource CoverImage},
                                                            ConverterParameter=120}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                            <Border Margin="6,1,0,0" Padding="4,1" CornerRadius="3"
                                                    Background="#252C3D" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCollaboration,
                                                                 Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="COLLAB" FontSize="8" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor,
                                                            Converter={StaticResource StringToBrush}}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                        </StackPanel>

                                        <ProgressBar Style="{StaticResource TransferProgressBar}" Height="3"
                                                     Margin="0,6,4,0" Value="{Binding Progress.Percent, Mode=OneWay}"
                                                     Visibility="{Binding IsBusy,
                                                                  Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Diagnostic banner: an empty or stale library explains itself here -->
                    <Border Grid.Row="3" Margin="0,10,0,12" Padding="10" CornerRadius="7"
                            Background="#1A1E12" BorderBrush="#3F4420" BorderThickness="1"
                            Visibility="{Binding HasLibraryMessage, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{Binding LibraryMessage}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="#D9CE8A" />
                    </Border>
                </Grid>
            </Border>

            <!-- === Detail pane === -->
            <Grid Grid.Column="1">

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="No games in the library yet" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="The library is built from your public itch.io profile page, including games hosted under collaborators' accounts. Check the profile name and sync again." />
                    <Button Content="Sync now" Style="{StaticResource GhostButton}" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Command="{Binding SyncLibraryCommand}" />
                </StackPanel>

                <!-- Selected game -->
                <Grid DataContext="{Binding SelectedGame}"
                      Visibility="{Binding DataContext.HasSelection,
                                   RelativeSource={RelativeSource AncestorType=Window},
                                   Converter={StaticResource BoolToVisible}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="256" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero -->
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Image Stretch="UniformToFill" Opacity="0.55"
                               Source="{Binding CoverImageUrl,
                                        Converter={StaticResource CoverImage},
                                        ConverterParameter=900}" />
                        <Border Background="{StaticResource HeroFadeBrush}" />

                        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Padding="6,2" CornerRadius="4" Background="#252C3D"
                                        Visibility="{Binding IsCollaboration,
                                                     Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="COLLABORATION" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                        <StackPanel>

                            <!-- Action row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource PrimaryActionButton}"
                                        Content="{Binding ActionText}"
                                        IsEnabled="{Binding CanAct}"
                                        Command="{Binding DataContext.PrimaryActionCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}" />

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding StatusColor,
                                                        Converter={StaticResource StringToBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SavingsText}" FontSize="11" Margin="15,3,0,0"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Visibility="{Binding HasSavings,
                                                            Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.CancelCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding IsBusy,
                                                         Converter={StaticResource BoolToVisible}}" />
                                    <Button Content="Verify files" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Command="{Binding DataContext.VerifyCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding IsInstalled,
                                                         Converter={StaticResource BoolToVisible}}" />
                                    <Button Content="Folder" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenInstallFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding IsInstalled,
                                                         Converter={StaticResource BoolToVisible}}" />
                                    <Button Content="itch.io page" Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.OpenGamePageCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Transfer progress -->
                            <Border Margin="0,18,0,0" Padding="16" CornerRadius="9"
                                    Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Progress.Stage}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Progress.Percent, StringFormat={}{0:0}%}"
                                                   HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>

                                    <ProgressBar Style="{StaticResource TransferProgressBar}"
                                                 Value="{Binding Progress.Percent, Mode=OneWay}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Progress.FormattedProgress}"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Progress.FormattedSpeed}"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Progress.FormattedEta}"
                                                   FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Why this game cannot be installed yet -->
                            <Border Margin="0,18,0,0" Padding="16" CornerRadius="9"
                                    Background="#171A24" BorderBrush="#33405C" BorderThickness="1"
                                    Visibility="{Binding HasBlockerHint,
                                                 Converter={StaticResource BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="NOT PUBLISHED FOR PATCHING YET" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}" Margin="0,0,0,7" />
                                    <TextBlock Text="{Binding BlockerHint}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="Consolas" />
                                </StackPanel>
                            </Border>

                            <!-- Metadata -->
                            <Border Margin="0,18,0,0" Padding="18,14" CornerRadius="9"
                                    Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VERSION" Style="{StaticResource MetaLabel}" />
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource MetaLabel}" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PLATFORMS" Style="{StaticResource MetaLabel}" />
                                        <TextBlock Text="{Binding PlatformsText}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="LAST PLAYED" Style="{StaticResource MetaLabel}" />
                                        <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="ABOUT" Style="{StaticResource MetaLabel}" Margin="0,20,0,6" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"
                                       LineHeight="20" Foreground="{StaticResource TextMutedBrush}" />

                            <!-- Failure detail -->
                            <Border Margin="0,18,0,0" Padding="14" CornerRadius="9"
                                    Background="#2A1518" BorderBrush="#5B2A2F" BorderThickness="1"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#FCA5A5" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
